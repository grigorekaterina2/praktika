<Window x:Class="TaskPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Планировщик задач" Width="860" Height="500" MinWidth="760" MinHeight="420"
        Background="#DCEEFB" FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <!-- кнопки -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4DA8E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- подписи -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <!-- строки таблицы -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="34"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Background" Value="#FDECEA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Progress}" Value="100">
                    <Setter Property="Foreground" Value="Gray"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Высокий">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- уведомление -->
        <Border x:Name="Banner" Grid.ColumnSpan="2" Visibility="Collapsed"
                Background="#FFF3CD" BorderBrush="#F0C36D" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="OK" Margin="12,0,0,0" Padding="12,3"
                        Click="CloseBanner_Click"/>
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- форма -->
        <Border Grid.Row="1" Background="#F2F9FF" CornerRadius="8" Padding="16" Margin="0,0,14,0">
            <StackPanel>
                <TextBlock Text="Задача" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Название" Style="{StaticResource Label}"/>
                <TextBox x:Name="TitleBox" Padding="6"/>
                <TextBlock Text="Приоритет" Style="{StaticResource Label}"/>
                <ComboBox x:Name="PriorityBox" Padding="6"/>
                <TextBlock Text="Срок" Style="{StaticResource Label}"/>
                <DatePicker x:Name="DueBox"/>
                <TextBlock Text="Прогресс" Style="{StaticResource Label}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="42" TextAlignment="Right"
                               Text="{Binding Value, ElementName=ProgressSlider, StringFormat={}{0:0}%}"/>
                    <Slider x:Name="ProgressSlider" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                </DockPanel>
                <Button Content="Добавить" Margin="0,18,0,0" Click="Add_Click"/>
                <Button Content="Сохранить изменения" Click="Edit_Click"/>
                <Button Content="Удалить" Background="#E5484D" Click="Delete_Click"/>
            </StackPanel>
        </Border>

        <!-- таблица -->
        <DataGrid x:Name="TaskGrid" Grid.Row="1" Grid.Column="1"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#CFE6F7" Background="#F2F9FF" BorderThickness="0"
                  CanUserAddRows="False" SelectionChanged="TaskGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="100"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding DueText}" Width="95"/>
                <DataGridTemplateColumn Header="Прогресс" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4,0">
                                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="16"
                                             Foreground="#4DA8E8" Background="#CFE6F7" BorderThickness="0"/>
                                <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
