<Window x:Class="TaskManagerWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система управления проектами и задачами" Height="680" Width="1050"
        Background="#F5F3F8" Foreground="#2D2B30"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Общие стили для подписей -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A5266"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Стиль для стандартных текстовых полей -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2D2B30"/>
            <Setter Property="BorderBrush" Value="#D1C7BD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Кастомный стиль кнопок без белой вспышки/засвечивания при клике -->
        <Style x:Key="PurpleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#7B52AB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Наведение мыши -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6A419A"/>
                            </Trigger>
                            <!-- Нажатие на кнопку (не засвечивается) -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#573185"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки удаления -->
        <Style x:Key="RedButtonStyle" TargetType="Button" BasedOn="{StaticResource PurpleButtonStyle}">
            <Setter Property="Background" Value="#D9534F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C9302C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#AC2925"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для вкладок категорий (TabItem), исключающий синий/белый засвет -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#E6DFEE"/>
            <Setter Property="Foreground" Value="#5A5266"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Margin="0,0,2,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="10,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D8CDE5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#7B52AB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <TabControl Background="#FFFFFF" BorderBrush="#E0D7E8" BorderThickness="1">

            <!-- Вкладка 1: Проекты -->
            <TabItem Header="📂 Проекты">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Таблица проектов -->
                    <DataGrid x:Name="GridP" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionChanged="P_Select" Background="#FFFFFF" RowBackground="#FAFAFC" 
                              AlternatingRowBackground="#F0EBF5" Foreground="#2D2B30" BorderBrush="#E0D7E8"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8E0F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="35"/>
                            <DataGridTextColumn Header="Название проекта" Binding="{Binding Title}" Width="130"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="75"/>
                            <DataGridTextColumn Header="Конец" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="75"/>
                            <DataGridTextColumn Header="Прогресс" Binding="{Binding Progress, StringFormat={}{0}%}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Панель управления проектом -->
                    <Border Grid.Column="1" Margin="12,0,0,0" Background="#F8F5FA" Padding="14" CornerRadius="8" BorderBrush="#E0D7E8" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🛠 Управление проектом" FontSize="14" Foreground="#7B52AB"/>

                            <TextBlock Text="Название проекта *"/>
                            <TextBox x:Name="PT"/>

                            <TextBlock Text="Описание проекта"/>
                            <TextBox x:Name="PD" Height="65" TextWrapping="Wrap" AcceptsReturn="True"/>

                            <TextBlock Text="Дата начала"/>
                            <DatePicker x:Name="PS" Padding="3"/>

                            <TextBlock Text="Дата окончания"/>
                            <DatePicker x:Name="PE" Padding="3"/>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                                <Button Content="Сохранить" Style="{StaticResource PurpleButtonStyle}" Width="90" Height="30" Click="P_Save" Margin="0,0,6,0"/>
                                <Button Content="Удалить" Style="{StaticResource RedButtonStyle}" Width="80" Height="30" Click="P_Del"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Сотрудники -->
            <TabItem Header="👥 Сотрудники">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Таблица сотрудников -->
                    <DataGrid x:Name="GridE" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionChanged="E_Select" Background="#FFFFFF" RowBackground="#FAFAFC" 
                              AlternatingRowBackground="#F0EBF5" Foreground="#2D2B30" BorderBrush="#E0D7E8"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8E0F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="35"/>
                            <DataGridTextColumn Header="ФИО сотрудника" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="130"/>
                            <DataGridTextColumn Header="Эл. почта (Email)" Binding="{Binding Email}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Панель управления сотрудником -->
                    <Border Grid.Column="1" Margin="12,0,0,0" Background="#F8F5FA" Padding="14" CornerRadius="8" BorderBrush="#E0D7E8" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="👤 Данные сотрудника" FontSize="14" Foreground="#7B52AB"/>

                            <TextBlock Text="ФИО сотрудника *"/>
                            <TextBox x:Name="EN"/>

                            <TextBlock Text="Должность"/>
                            <TextBox x:Name="EP"/>

                            <TextBlock Text="Электронная почта (Email)"/>
                            <TextBox x:Name="EM"/>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                                <Button Content="Сохранить" Style="{StaticResource PurpleButtonStyle}" Width="90" Height="30" Click="E_Save" Margin="0,0,6,0"/>
                                <Button Content="Удалить" Style="{StaticResource RedButtonStyle}" Width="80" Height="30" Click="E_Del"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Задачи -->
            <TabItem Header="📋 Задачи">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Таблица задач -->
                    <DataGrid x:Name="GridT" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionChanged="T_Select" Background="#FFFFFF" RowBackground="#FAFAFC" 
                              AlternatingRowBackground="#F0EBF5" Foreground="#2D2B30" BorderBrush="#E0D7E8"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8E0F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="35"/>
                            <DataGridTextColumn Header="Проект" Binding="{Binding ProjTitle}" Width="110"/>
                            <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="120"/>
                            <DataGridTextColumn Header="Исполнитель" Binding="{Binding EmpName}" Width="110"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Панель управления задачей -->
                    <Border Grid.Column="1" Margin="12,0,0,0" Background="#F8F5FA" Padding="14" CornerRadius="8" BorderBrush="#E0D7E8" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📌 Назначение и статус задачи" FontSize="13" Foreground="#7B52AB"/>

                            <TextBlock Text="Выберите проект *"/>
                            <ComboBox x:Name="CProject" DisplayMemberPath="Title" SelectedValuePath="Id" Padding="3"/>

                            <TextBlock Text="Название задачи *"/>
                            <TextBox x:Name="TT"/>

                            <TextBlock Text="Назначить сотрудника"/>
                            <ComboBox x:Name="CEmp" DisplayMemberPath="FullName" SelectedValuePath="Id" Padding="3"/>

                            <TextBlock Text="Текущий статус"/>
                            <ComboBox x:Name="CStatus" Padding="3">
                                <ComboBoxItem Content="Новая"/>
                                <ComboBoxItem Content="В работе"/>
                                <ComboBoxItem Content="Завершена"/>
                                <ComboBoxItem Content="Отменена"/>
                            </ComboBox>

                            <TextBlock Text="Срок выполнения (Дедлайн)"/>
                            <DatePicker x:Name="TD" Padding="3"/>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                                <Button Content="Сохранить" Style="{StaticResource PurpleButtonStyle}" Width="90" Height="30" Click="T_Save" Margin="0,0,6,0"/>
                                <Button Content="Удалить" Style="{StaticResource RedButtonStyle}" Width="80" Height="30" Click="T_Del"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Отчеты -->
            <TabItem Header="📊 Отчетность">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="Сформировать отчет по проектам" Style="{StaticResource PurpleButtonStyle}" 
                            Width="250" Height="34" Click="GenReport" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <TextBox x:Name="TxtR" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" 
                             Background="#2A2433" Foreground="#BFA5E6" BorderBrush="#E0D7E8" Padding="12"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>