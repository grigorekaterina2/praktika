<Window x:Class="TaskManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет задач" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="10" Margin="0,0,10,0" Background="#FFF9F9F9">
            <StackPanel>
                <TextBlock Text="Панель задачи" FontWeight="Bold" FontSize="16" Margin="0,0,10,15"/>
                <TextBlock Text="Название:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtTitle" Margin="0,0,0,10" Padding="3"/>
                <TextBlock Text="Описание:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtDescription" Margin="0,0,0,10" Padding="3" Height="60" AcceptsReturn="True"/>
                <TextBlock Text="Статус:" Margin="0,0,0,3"/>
                <ComboBox x:Name="cmbStatus" Margin="0,0,0,10" Padding="3">
                    <ComboBoxItem Content="К выполнению"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Выполнена"/>
                </ComboBox>
                <Button x:Name="btnSave" Content="Добавить / Сохранить" Click="BtnSave_Click" Background="#FF4CAF50" Foreground="White" Padding="8" Margin="0,5,0,5"/>
                <Button x:Name="btnClear" Content="Очистить" Click="BtnClear_Click" Padding="8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="dgTasks" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="DgTasks_SelectionChanged" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="150"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnDelete" Content="Удалить задачу" Click="BtnDelete_Click" Background="#FFF44336" Foreground="White" Padding="10,5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>