<Window x:Class="EmployeeManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет сотрудников организации" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: Форма ввода/редактирования -->
        <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="10" Margin="0,0,10,0" Background="#FFF9F9F9">
            <StackPanel>
                <TextBlock Text="Панель сотрудника" FontWeight="Bold" FontSize="16" Margin="0,0,10,15"/>

                <TextBlock Text="ФИО:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtFullName" Margin="0,0,0,10" Padding="3"/>

                <TextBlock Text="Должность:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtPosition" Margin="0,0,0,10" Padding="3"/>

                <TextBlock Text="Отдел:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtDepartment" Margin="0,0,0,10" Padding="3"/>

                <TextBlock Text="Зарплата (руб.):" Margin="0,0,0,3"/>
                <TextBox x:Name="txtSalary" Margin="0,0,0,15" Padding="3"/>

                <Button x:Name="btnSave" Content="Добавить / Сохранить" Click="BtnSave_Click" Background="#FF4CAF50" Foreground="White" Padding="8" Margin="0,0,0,5"/>
                <Button x:Name="btnClear" Content="Очистить форму" Click="BtnClear_Click" Padding="8"/>
            </StackPanel>
        </Border>

        <!-- Правая панель: Таблица и кнопка удаления -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dgEmployees" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionMode="Single" SelectionChanged="DgEmployees_SelectionChanged" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="110"/>
                    <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="100"/>
                    <DataGridTextColumn Header="Зарплата" Binding="{Binding Salary}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnDelete" Content="Удалить выбранную запись" Click="BtnDelete_Click" Background="#FFF44336" Foreground="White" Padding="10,5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>