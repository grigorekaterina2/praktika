<Window x:Class="LibraryManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека" Height="480" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: добавление новой книги -->
        <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="10" Margin="0,0,10,0" Background="#FFF9F9F9">
            <StackPanel>
                <TextBlock Text="Новая книга" FontWeight="Bold" FontSize="16" Margin="0,0,10,15"/>
                <TextBlock Text="Название:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtTitle" Margin="0,0,0,10" Padding="3"/>
                <TextBlock Text="Автор:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtAuthor" Margin="0,0,0,10" Padding="3"/>
                <TextBlock Text="Год издания:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtYear" Margin="0,0,0,15" Padding="3"/>
                <Button x:Name="btnAdd" Content="Добавить книгу" Click="BtnAdd_Click" Background="#FF4CAF50" Foreground="White" Padding="8"/>
            </StackPanel>
        </Border>

        <!-- Правая панель: поиск, таблица и аренда -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="txtSearch" Width="250" Padding="3" Margin="0,0,5,0"/>
                <Button x:Name="btnSearch" Content="Найти" Click="BtnSearch_Click" Padding="10,3" Margin="0,0,5,0"/>
                <Button x:Name="btnReset" Content="Сбросить" Click="BtnReset_Click" Padding="10,3"/>
            </StackPanel>

            <DataGrid x:Name="dgBooks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="130"/>
                    <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="50"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="85"/>
                    <DataGridTextColumn Header="Читатель" Binding="{Binding RentedBy}" Width="100"/>
                    <DataGridTextColumn Header="Дата аренды" Binding="{Binding RentDate}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Читатель:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="txtReader" Width="160" Padding="3" Margin="0,0,10,0"/>
                <Button x:Name="btnRent" Content="Арендовать" Click="BtnRent_Click" Background="#FF2196F3" Foreground="White" Padding="10,5" Margin="0,0,5,0"/>
                <Button x:Name="btnReturn" Content="Вернуть книгу" Click="BtnReturn_Click" Padding="10,5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
