<Window x:Class="FinanceManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет финансов" Height="480" Width="850" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: форма записи -->
        <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="10" Margin="0,0,10,0" Background="#FFF9F9F9">
            <StackPanel>
                <TextBlock Text="Панель записи" FontWeight="Bold" FontSize="16" Margin="0,0,10,15"/>
                <TextBlock Text="Тип:" Margin="0,0,0,3"/>
                <ComboBox x:Name="cmbType" Margin="0,0,0,10" Padding="3" SelectedIndex="0">
                    <ComboBoxItem Content="Доход"/>
                    <ComboBoxItem Content="Расход"/>
                </ComboBox>
                <TextBlock Text="Категория:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtCategory" Margin="0,0,0,10" Padding="3"/>
                <TextBlock Text="Сумма (руб.):" Margin="0,0,0,3"/>
                <TextBox x:Name="txtAmount" Margin="0,0,0,10" Padding="3"/>
                <TextBlock Text="Дата:" Margin="0,0,0,3"/>
                <DatePicker x:Name="dpDate" Margin="0,0,0,10"/>
                <TextBlock Text="Описание:" Margin="0,0,0,3"/>
                <TextBox x:Name="txtDescription" Margin="0,0,0,15" Padding="3" Height="50" AcceptsReturn="True"/>
                <Button x:Name="btnSave" Content="Добавить / Сохранить" Click="BtnSave_Click" Background="#FF4CAF50" Foreground="White" Padding="8" Margin="0,0,0,5"/>
                <Button x:Name="btnClear" Content="Очистить форму" Click="BtnClear_Click" Padding="8"/>
            </StackPanel>
        </Border>

        <!-- Правая панель: таблица и итоги -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dgRecords" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="DgRecords_SelectionChanged" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="70"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="80"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="85"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="tbIncome" Text="Доходы: 0" FontWeight="Bold" Foreground="#FF2E7D32" Margin="0,0,20,0"/>
                <TextBlock x:Name="tbExpense" Text="Расходы: 0" FontWeight="Bold" Foreground="#FFC62828" Margin="0,0,20,0"/>
                <TextBlock x:Name="tbBalance" Text="Баланс: 0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
