<Window x:Class="PasswordManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер паролей" Height="480" Width="640"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid>

        <!-- ===== Окно входа (мастер-пароль) ===== -->
        <Grid x:Name="pnlLogin" Background="White" Panel.ZIndex="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                <TextBlock Text="Менеджер паролей" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Мастер-пароль:"/>
                <PasswordBox x:Name="pbMaster" Margin="0,5,0,10" Height="25"/>

                <StackPanel x:Name="pnlConfirm">
                    <TextBlock Text="Повторите мастер-пароль:"/>
                    <PasswordBox x:Name="pbConfirm" Margin="0,5,0,10" Height="25"/>
                </StackPanel>

                <Button x:Name="btnLogin" Content="Войти" Height="30" IsDefault="True"
                        Click="BtnLogin_Click"/>
                <TextBlock x:Name="txtError" Foreground="Red" Margin="0,10,0,0"
                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ===== Основное окно ===== -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="grid" Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Сайт / сервис" Binding="{Binding Site}" Width="*"/>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                    <DataGridTextColumn Header="Пароль" Binding="{Binding Masked}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Сайт:" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbSite" Grid.Column="1" Height="25"/>
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Логин:" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbLogin" Grid.Column="1" Height="25"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Пароль:" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="pbPassword" Grid.Column="1" Height="25"/>
                    <TextBox x:Name="tbPasswordVisible" Grid.Column="1" Height="25"
                             Visibility="Collapsed"/>
                    <CheckBox x:Name="chkShow" Grid.Column="2" Content="Показать"
                              VerticalAlignment="Center" Margin="10,0,0,0"
                              Checked="ChkShow_Changed" Unchecked="ChkShow_Changed"/>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Добавить" Width="95" Height="30" Margin="0,0,10,0"
                            Click="BtnAdd_Click"/>
                    <Button Content="Изменить" Width="95" Height="30" Margin="0,0,10,0"
                            Click="BtnEdit_Click"/>
                    <Button Content="Удалить" Width="95" Height="30" Margin="0,0,10,0"
                            Click="BtnDelete_Click"/>
                    <Button Content="Сгенерировать" Width="110" Height="30" Margin="0,0,10,0"
                            Click="BtnGenerate_Click"/>
                    <Button Content="Копировать пароль" Width="140" Height="30"
                            Click="BtnCopy_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
